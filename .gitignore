# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# 虚拟环境
.venv/
venv/

# 环境与密钥（.env.example 是发布材料模板，必须入库）
.env
.env.*
!.env.example

# 运行时数据（对话记忆与向量库；data/notes 是语料资产，仍进库）
data/memory/
data/vector_db/
data/todos.json
data/audit/
data/checkpoints/
data/worktrees/
data/evals/
# 060 失败台账：plan 归档的派生索引（真值源＝session.json），可删可重建
data/plan_failures.jsonl
servers/sandbox/

# 外部公开基准（LongMemEval 等）：单文件数百 MB，可一键重下，不入库
data/bench/

# 实机跑出来的笔记产物（不属人工策展的语料库；逐篇点名，等有命名约定再收口）
data/notes/阿里巴巴股价分析报告-2026年9月24日.md

# 笔记来源 sidecar（053）：运行时元数据，tracked 会让每次 write_note 都产生
# diff 噪音；且 `git archive HEAD` 副本因此天然不带它，冻结集 verify 口径零影响
data/notes/.provenance.json

# 审查改写留痕 sidecar（064）：append-only 事件日志，同 053 的不入库理由
data/learned/.review.jsonl

# learned 记忆（ADR 070）：助手跑出来的个人记忆，属运行时数据非代码资产——
# 开源分发不该自带「作者的偏好」。目录仍由代码自动创建，模板见
# data/learned/constraints.example.md（示例文件入库）
data/learned/*.md
!data/learned/constraints.example.md

# 内部文档（开源前脱敏与下沉，2026-09-29）：战略定位 / 私人使用台账 / 旧时代叙
事评审快照 / 开源行动项诊断。文件留在本地但不进 git——避免公开护城河/产品判断
/私人任务台账/外部专家对原作者的评价。文档如有重构后版本，再单独加入。
docs/internal/

# IDE / agent 工作区规则
.trae/

# 系统文件
.DS_Store

# Node（FW 站）：源码在 frontend/，构建产物落 src/facta/server/static/fw/（进 git）
frontend/node_modules/
