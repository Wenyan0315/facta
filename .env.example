# 复制为 .env 后填入真实 key（.env 已被 .gitignore 排除，不会入库）
# Copy to .env and fill in real keys (.env is gitignored)

# —— 必填：真模型供应商（{前缀}_API_KEY / _BASE_URL / _MODEL）——
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# —— 可选：RAG 向量嵌入（装 [rag] 后生效；不装则自动用词袋嵌入）——
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# —— 可选：联网搜索（不填则联网工具不可用，其余功能不受影响）——
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# —— 可选：M10 场景路由（Jev）；不配置则走原生全菜单路径 ——
# JEV_API_KEY=
# JEV_BASE_URL=

# —— 可选：运行开关 ——
# AGENT_PROVIDER=deepseek          # Web 入口的模型供应商（CLI 走 argv）
# FACTA_SANDBOX=off               # 强制关闭终端命令沙箱（其余值/缺省=auto）
# FACTA_SEMANTIC_CACHE=1          # 打开 LLM 语义缓存
# FACTA_USER_MEMORY=/path/to/user.md   # 用户级记忆落盘位置
