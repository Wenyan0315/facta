# 复制为 .env 后填入真实 key（.env 已被 .gitignore 排除，不会入库）
# Copy to .env and fill in real keys (.env is gitignored)

# —— 主模型供应商：FACTA_PROVIDER 选哪家，另一家提供商做下面的对应 API key —
# 可选：mock / echo / repeat（教学，离线）/ deepseek / deepseek-flash / siliconflow /
#       openai / qwen / zhipu / moonshot
# 不在表里的中转商不必加代码：{PREFIX}_BASE_URL / _MODEL 环境变量直接覆盖
# 旧名 AGENT_PROVIDER 仍兼容（deprecation 注记）

# —— DeepSeek（默认主力）——
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat       # 或 deepseek-flash（更便宜，M10 首选）

# —— 硅基流动（中文友好，备选主模型 + 默认 embedding）——
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# —— OpenAI（gpt-4o-mini 经济档；embedding 也可选）——
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# —— 通义千问（阿里 DashScope 兼容入口）——
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# —— 智谱（BigModel）——
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-flash

# —— 月之暗面 Moonshot ——
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=moonshot-v1-8k

# —— embedding 供应商选择（ADR 070）：默认 siliconflow ——
# FACTA_EMBED_PROVIDER=siliconflow   # 可选：siliconflow / openai
# FACTA_EMBED_PROVIDER 默认时不需要设置；想用 OpenAI embedding 设 FACTA_EMBED_PROVIDER=openai + 上方 OPENAI_API_KEY

# —— 联网搜索（不填则联网工具不可用，其余功能不受影响）——
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# —— 可选：M10 场景路由（Jev）；不配置则走原生全菜单路径 ——
# JEV_API_KEY=
# JEV_BASE_URL=

# —— 运行开关 ——
# FACTA_PROVIDER=mock              # Web 入口的模型供应商（CLI 走 argv）
# FACTA_SANDBOX=workspace-write   # 执行隔离档（086）：none / workspace-write / container
#                                 #   none=关围栏（旧 off 同义）；workspace-write=默认档（写限项目根+TMPDIR）
#                                 #   container=容器隔离（后置，本版诚实降级 workspace-write）
# FACTA_APPROVAL_POLICY=on-request # 确认策略（086）：untrusted / on-request / never
#                                 #   untrusted=全确认；on-request=默认（按工具）；never=跳过确认（bot/无头）
# FACTA_SEMANTIC_CACHE=1          # 打开 LLM 语义缓存（实验性，注意跨上下文串味）
# FACTA_USER_MEMORY=/path/to/user.md   # 用户级记忆落盘位置